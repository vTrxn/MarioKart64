    <effect id="mat_tire_std_eff_id" name="mat_tire_std_eff">
      <profile_COMMON>
        <newparam sid="mat_tire_std_surf">
          <surface type="2D">
            <init_from>tire_std_default_color</init_from>
            <format>PNG</format>
