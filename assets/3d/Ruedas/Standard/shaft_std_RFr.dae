            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>LINEAR_MIPMAP_NEAREST</minfilter>
            <magfilter>LINEAR</magfilter>
            <mipfilter>LINEAR</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="mat_tire_std_tech">
          <phong>
            <diffuse>
              <texture texture="mat_tire_std_samp" texcoord="uv" />
            </diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
