  <library_effects>
    <effect id="mat_tire_std_eff_id" name="mat_tire_std_eff">
      <profile_COMMON>
        <newparam sid="mat_tire_std_surf">
          <surface type="2D">
            <init_from>tire_std_default_color</init_from>
            <format>PNG</format>
          </surface>
        </newparam>
        <newparam sid="mat_tire_std_samp">
          <sampler2D>
            <source>mat_tire_std_surf</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
            <minfilter>LINEAR_MIPMAP_NEAREST</minfilter>
            <magfilter>LINEAR</magfilter>
            <mipfilter>LINEAR</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="mat_tire_std_tech">
          <phong>
            <diffuse>
              <texture texture="mat_tire_std_samp" texcoord="uv" />
            </diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
