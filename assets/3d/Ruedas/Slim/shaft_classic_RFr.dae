  <library_effects>
    <effect id="mat_tire_classic_eff_id" name="mat_tire_classic_eff">
      <profile_COMMON>
        <newparam sid="mat_tire_classic_surf">
          <surface type="2D">
            <init_from>tire_classic_color</init_from>
            <format>PNG</format>
