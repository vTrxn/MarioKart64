            <mipfilter>LINEAR</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="mat_tire_classic_tech">
          <phong>
            <diffuse>
              <texture texture="mat_tire_classic_samp" texcoord="uv" />
            </diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
